# `.gitignore` keeps `!.git*` so that .gitignore, .github and .gitattributes stay
# tracked; that same negation would otherwise pull the whole `.git` directory —
# object database included — into the published tarball.
.git/
_build/
target/

# Examples that pull in another library are their own module, built against this
# one only when someone checks the interop out: nobody installing this needs the
# server runtime they carry.
integration/
