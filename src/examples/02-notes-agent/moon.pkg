// A complete agent: sessions that outlive the connection, streaming answers, modes and
// configuration, and the whole of `session/*`. Run it with
// `moon run src/examples/02-notes-agent --target native` and drive it with any ACP client,
// including the official conformance suite.
supported_targets = "+native"

import {
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/core/json",
  "moonbitstack/moonacp",
  "moonbitstack/moonacp/stdio",
  "moonbitstack/moonjrpc/peer",
}

pkgtype(kind: "executable")
