// Telemetry for the two sides of the protocol.
//
// Two wrappers per side: `traced` and `metered` for an agent, `traced_client` and `metered_client`
// for an editor. They record the operations the OpenTelemetry GenAI semantic conventions name, and
// every span, metric and attribute they write is spelled by `moontel/semconv`, which is generated
// from the registry at the commit the conventions pin.
//
// https://github.com/open-telemetry/semantic-conventions-genai
import {
  "moonbitlang/async",
  "moonbitstack/moonacp",
  "moonbitstack/moontel/otlp",
  "moonbitstack/moontel/semconv",
  "moonbitstack/moontel/trace",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonjrpc/peer",
  "moonbitstack/moontel/otlp",
} for "wbtest"
