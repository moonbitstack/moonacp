// Tracing for the two sides of the protocol.
//
// One wrapper per side: `traced` for an agent, `traced_client` for an editor. Both record the
// operations the OpenTelemetry GenAI semantic conventions name, and every span and attribute
// these wrappers write is spelled by `moontel/semconv`, which is generated from the registry at
// the commit the conventions pin.
//
// https://github.com/open-telemetry/semantic-conventions-genai
import {
  "moonbitlang/async",
  "moonbitstack/moonacp",
  "moonbitstack/moontel/semconv",
  "moonbitstack/moontel/trace",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitstack/moonjrpc/peer",
} for "wbtest"
